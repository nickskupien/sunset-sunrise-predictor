{
  "name": "sunset-predictor",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "lighthouse:audit": "./scripts/lhci-audit.sh",
    "lighthouse:dashboard:start": "./scripts/lhci-start-dashboard.sh",
    "lighthouse:dashboard:stop": "docker compose --profile observability stop lhci-server",
    "lighthouse:dashboard:upload": "./scripts/lhci-upload-dashboard.sh",
    "lighthouse:dashboard:setup": "lhci wizard",
    "db:generate": "pnpm --filter @sunset/db db:generate",
    "db:migrate": "pnpm --filter @sunset/db db:migrate"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "vitest": "^3.1.1"
  }
}
